{
  "name": "ai-os",
  "version": "6.0.1",
  "description": "A desktop workspace where a human and AI agent work together.",
  "private": true,
  "main": "desktop/main.cjs",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "desktop": "electron .",
    "runtime:python": "python scripts/build-python-runtime.py build",
    "installer:art": "python scripts/build-installer-art.py",
    "desktop:package": "pnpm runtime:python && pnpm installer:art && pnpm build && electron-builder --win nsis",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --no-warnings --test \"src/**/*.test.mjs\" \"desktop/*.test.cjs\"",
    "test:coverage": "node --no-warnings --experimental-test-coverage --test-coverage-include=\"src/lib/**\" --test-coverage-include=\"desktop/**\" --test-coverage-exclude=\"**/*.test.*\" --test \"src/**/*.test.mjs\" \"desktop/*.test.cjs\"",
    "test:engine": "cd tasks-engine && python -m pytest -q",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@use-gesture/react": "^10.3.1",
    "clsx": "^2.1.1",
    "motion": "^14.9.0",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "^9.3.14",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.6",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.aios.desktop",
    "productName": "PMO Desk",
    "icon": "desktop/icon.ico",
    "asar": false,
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      ".next/**/*",
      "public/**/*",
      "package.json",
      "node_modules/**/*",
      "!.next/cache/**",
      "!.next/dev/**",
      "!.next/trace*",
      "!node_modules/.cache/**",
      "!node_modules/@next/swc-win32-x64-msvc/**",
      "!node_modules/sharp/**",
      "!node_modules/@img/**",
      "!node_modules/.pnpm/@next+swc-*/**",
      "!node_modules/.pnpm/sharp@*/**",
      "!node_modules/.pnpm/@img+*/**",
      "!.next/**/*.map",
      "!tasks-engine/.coverage",
      "!**/pytest.ini",
      "!desktop/*.test.cjs",
      "!desktop/live-config.json",
      "tasks-engine/**/*",
      "tasks/**/*",
      "!tasks-engine/.venv/**",
      "!tasks-engine/.data/**",
      "!tasks-engine/tests/**",
      "!tasks/.venv/**",
      "!tasks/**/tests/**",
      "!tasks/**/input/**",
      "!tasks/**/output/**",
      "!tasks/*/reference/**",
      "!tasks/**/config/backups/**",
      "!tasks/**/config/**",
      "!tasks/**/templates/**",
      "!tasks/**/reference/**",
      "!tasks/**/backups/**",
      "!tasks/shared/roster-reference/**/*.xls*",
      "!tasks/shared/roster/Names.xlsx",
      "!tasks/**/*.snapshot.json",
      "!tasks/**/*.plan.json",
      "!tasks/**/.venv/**",
      "!tasks/**/~$*",
      "pmo-intake/scripts/*.ps1",
      "!pmo-intake/scripts/tests/**",
      "!**/__pycache__/**",
      "!**/.pytest_cache/**"
    ],
    "extraResources": [
      {
        "from": "build/python-runtime/python",
        "to": "python"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh",
      "installerIcon": "desktop/icon.ico",
      "uninstallerIcon": "desktop/icon.ico",
      "installerHeaderIcon": "desktop/icon.ico",
      "installerSidebar": "build/installer/sidebar.bmp",
      "uninstallerSidebar": "build/installer/sidebar.bmp",
      "installerHeader": "build/installer/header.bmp",
      "oneClick": false,
      "shortcutName": "PMO Desk"
    }
  }
}
