# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# the desktop launcher's own UI builds (desktop/ui-build.cjs)
/.next-live*
/out/

# production
/build
/release
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tasks: real client/employee data and generated artifacts (never commit)
tasks/**/input/
tasks/**/output/
tasks/**/config/
tasks/**/reference/
tasks/**/templates/
tasks/.venv/
tasks/shared/roster-reference/*
!tasks/shared/roster-reference/README.md

# tasks engine: local venv and runtime data (run history)
/tasks-engine/.venv/
/tasks-engine/.data/

# python
__pycache__/
**/__pycache__/
*.pyc
.coverage

# Office lock files
~$*

# tasks: real employee roster (names/emails) - never commit
tasks/shared/roster/Names.xlsx

# local live-mode override for the Electron shell (see README)
/desktop/live-config.json
