# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent-apps: real client/employee data and generated artifacts (never commit)
agent-apps/**/input/
agent-apps/**/output/
agent-apps/**/config/
agent-apps/**/reference/
agent-apps/**/templates/
agent-apps/.venv/
agent-apps/shared/roster-reference/*
!agent-apps/shared/roster-reference/README.md

# python
__pycache__/
**/__pycache__/
*.pyc
.coverage

# Office lock files
~$*

# agent-apps: real employee roster (names/emails) - never commit
agent-apps/shared/roster/Names.xlsx
