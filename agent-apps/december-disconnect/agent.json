{
  "id": "december-disconnect",
  "displayName": "December Disconnect",
  "runtime": "local",
  "completedMessage": "The final winter plans (main plan and Analytics plan) and the audit log are ready in the output folder.",
  "inputs": [
    {
      "id": "roster",
      "label": "Shift roster workbook",
      "type": "file",
      "accept": [".xlsx"],
      "dest": "input/roster.xlsx",
      "required": true
    },
    {
      "id": "staff",
      "label": "PDT staff roster workbook",
      "type": "file",
      "accept": [".xlsx"],
      "dest": "input/staff-roster.xlsx",
      "required": true
    },
    {
      "id": "analytics_a",
      "label": "Analytics roster, first month (optional)",
      "type": "file",
      "accept": [".xlsx"],
      "dest": "input/analytics-a.xlsx",
      "required": false
    },
    {
      "id": "analytics_b",
      "label": "Analytics roster, second month (optional)",
      "type": "file",
      "accept": [".xlsx"],
      "dest": "input/analytics-b.xlsx",
      "required": false
    },
    {
      "id": "window",
      "label": "Disconnect window",
      "type": "select",
      "optionsFile": "output/options.json",
      "optionsKey": "windows",
      "required": true
    }
  ],
  "prepare": {
    "cmd": "scripts/prepare_options.py",
    "after": ["roster", "staff"]
  },
  "steps": [
    {
      "id": "analyze",
      "type": "python",
      "cmd": "scripts/analyze.py",
      "label": "Check the rosters and list the questions"
    },
    {
      "id": "answers",
      "type": "review",
      "label": "Answer the questions",
      "reviewMessage": "A few questions need your answer before the winter plans can be built",
      "gate": {
        "type": "form",
        "schema": "output/ask-me.json",
        "answers": "output/ask-me-answers.json"
      }
    },
    {
      "id": "build_draft",
      "type": "python",
      "cmd": "scripts/build_draft.py",
      "label": "Build the draft winter plans"
    },
    {
      "id": "review_draft",
      "type": "review",
      "label": "Review the drafts in Excel",
      "reviewMessage": "Both drafts are ready (the main plan and the Analytics plan, in the output folder): open them, fix anything that needs fixing, save them under the same names, then approve",
      "gate": {
        "type": "flags",
        "file": "output/flags.json"
      }
    },
    {
      "id": "diff_draft",
      "type": "python",
      "cmd": "scripts/diff_draft.py",
      "label": "Compare your edits with the drafts"
    },
    {
      "id": "confirm_diff",
      "type": "confirm",
      "label": "Confirm the changes",
      "reviewMessage": "Look at every changed cell in both plans and confirm to build the final plans",
      "gate": {
        "type": "diff",
        "file": "output/roster-diff.json"
      }
    },
    {
      "id": "finalize",
      "type": "python",
      "cmd": "scripts/finalize.py",
      "label": "Build the final winter plans"
    }
  ]
}
